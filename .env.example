NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by app/api/auth/route.ts to check /admin and /scan
# passwords against the app_passwords table. NEVER prefix this with
# NEXT_PUBLIC_ or it ships to the browser. Find it in Supabase:
# Project Settings -> API -> service_role key (marked "secret").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
